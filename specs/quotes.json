            "QuoteCreate": {
                "properties": {
                    "sell_currency": {
                        "type": "string",
                        "maxLength": 3,
                        "minLength": 3,
                        "pattern": "^[A-Za-z]{3}$",
                        "title": "Sell Currency",
                        "description": "Source currency (ISO 4217, 3-letter). Must be DKK or EUR \u2014 Paer's limited PI license only permits these two as source.",
                        "examples": [
                            "EUR",
                            "DKK"
                        ]
                    },
                    "buy_currency": {
                        "type": "string",
                        "maxLength": 3,
                        "minLength": 3,
                        "pattern": "^[A-Za-z]{3}$",
                        "title": "Buy Currency",
                        "description": "Destination currency (ISO 4217, 3-letter). See `GET /v1/fx/corridors` for the full supported list.",
                        "examples": [
                            "USD",
                            "BRL",
                            "INR",
                            "JPY"
                        ]
                    },
                    "sell_amount": {
                        "anyOf": [
                            {
                                "type": "number",
                                "exclusiveMaximum": 1000000000.0,
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "string",
                                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Sell Amount",
                        "description": "Amount to SELL, denominated in `sell_currency`. **Provide EXACTLY ONE of `sell_amount` or `buy_amount`.** Range: 0.01 to 999,999,999.",
                        "examples": [
                            "1000.00"
                        ]
                    },
                    "buy_amount": {
                        "anyOf": [
                            {
                                "type": "number",
                                "exclusiveMaximum": 1000000000.0,
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "string",
                                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Buy Amount",
                        "description": "Amount to BUY, denominated in `buy_currency`. **Provide EXACTLY ONE of `sell_amount` or `buy_amount`.** Range: 0.01 to 999,999,999.",
                        "examples": [
                            "1000.00"
                        ]
                    },
                    "destination_country": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 2,
                                "minLength": 2,
                                "pattern": "^[A-Za-z]{2}$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Destination Country",
                        "description": "Beneficiary bank's country (ISO 3166-1 alpha-2). Optional. If omitted, defaults to the native country of `buy_currency` (e.g. US for USD). Pass a non-native country to route via SWIFT for off-country holdings (e.g. INR held at a UK bank: set `destination_country=GB`).",
                        "examples": [
                            "US",
                            "BR",
                            "IN",
                            "GB"
                        ]
                    },
                    "payout_method": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 32,
                                "pattern": "^[A-Za-z0-9_]+$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Payout Method",
                        "description": "Specific payout rail code. Optional. If omitted, the fastest rail for the corridor is used. See `GET /v1/fx/corridors` for valid codes per (buy_currency, destination_country). Examples: `PIX` (BRL/BR), `SPEI` (MXN/MX), `IMPS` (INR/IN), `RTP` (USD/US), `SWIFT` (off-country fallback).",
                        "examples": [
                            "RTP",
                            "PIX",
                            "SPEI",
                            "SWIFT"
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "sell_currency",
                    "buy_currency"
                ],
                "title": "QuoteCreate",
                "description": "Body for `POST /v1/quotes`.\n\nRequired fields: `sell_currency`, `buy_currency`, AND **exactly one** of\n`sell_amount` or `buy_amount`. Omitting both or providing both returns 422.\n\nOptional fields: `destination_country` (ISO 3166-1 alpha-2), `payout_method`\n(see `GET /v1/fx/corridors` for valid codes per corridor).",
                "examples": [
                    {
                        "buy_currency": "USD",
                        "destination_country": "US",
                        "payout_method": "RTP",
                        "sell_amount": "1000.00",
                        "sell_currency": "EUR"
                    },
                    {
                        "buy_amount": "5000.00",
                        "buy_currency": "BRL",
                        "destination_country": "BR",
                        "payout_method": "PIX",
                        "sell_currency": "DKK"
                    },
                    {
                        "buy_currency": "DKK",
                        "sell_amount": "500.00",
                        "sell_currency": "EUR"
                    }
                ]
            },
